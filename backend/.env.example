APP_ENV=development
APP_NAME=Fact-O-Check
API_PREFIX=/api
# Local default; use a mongodb+srv:// Atlas URI in production.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=fact_o_check
# Comma-separated explicit origins. Do not use * because credentials are enabled.
CORS_ORIGINS=http://localhost:5173
MAX_UPLOAD_SIZE_BYTES=26214400
# Choose one provider: openai or openrouter.
LLM_PROVIDER=openrouter
# OpenAI model ID or an OpenRouter model slug, depending on LLM_PROVIDER.
LLM_MODEL=<model slug>
# Used only when LLM_PROVIDER=openai.
LLM_API_KEY=
# Used only when LLM_PROVIDER=openrouter.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional OpenRouter attribution headers. The code reads OPENROUTER_X_TITLE.
OPENROUTER_HTTP_REFERER=
OPENROUTER_X_TITLE=Fact-O-Check
LLM_TIMEOUT_SECONDS=45
EXTRACTION_WINDOW_CHARS=12000
EXTRACTION_WINDOW_CHUNKS=20
EXTRACTION_MAX_WINDOWS=30
EXTRACTION_MAX_OUTPUT_TOKENS=4000
